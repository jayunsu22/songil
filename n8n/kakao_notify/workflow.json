    {
      "id": "c",
      "name": "글만들기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 카톡_알림 › 글만들기: 받은 text 를 텔레그램 글로. 4000자 넘으면 자른다 (텔레그램 한도 4096).\nconst b = $('받은알림').first().json.body || {};\n// 텔레그램이 글을 서식(마크다운)으로 읽으면 '[카톡]' 이 사라지고 _ * 가 섞이면 안 보내진다 → HTML 로 보내고 <>& 만 바꾼다 (10/31)\n// html: true 면 노트북이 이미 꾸민 글(굵게·'견적서 열기' 링크, 카톡 글은 노트북이 바꿔 넣음) → 그대로 (11/1). 사장님 열쇠로만 들어온다\nconst raw = String(b.text || '');\nconst text = b.html === true ? raw.slice(0, 4000) : raw.slice(0, 4000).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nif (!text) throw new Error('text 가 비어 있음');\nconst r = $input.first().json || {};\nconst chat = (r.fields || r).텔레그램_챗ID;\nif (!chat) throw new Error('가맹점 p_001 의 텔레그램_챗ID 가 비어 있음');\n// buttons: [[{text, data}]] (카톡 읽기 3단계 10/31) - 줄은 모아서 버튼 열 개까지 (11/1: 필름 주문 담당자 전부). 셋까지 한 줄, 넷부터 두 개씩. data 는 텔레그램 한도 64바이트\nconst b2 = (Array.isArray(b.buttons) ? b.buttons : []).filter(Array.isArray).reduce((a, r) => a.concat(r), [])\n  .filter((x) => x && x.text && x.data).slice(0, 10).map((x) => ({ t: String(x.text).slice(0, 30), d: String(x.data).slice(0, 64) }));\nreturn [{ json: { chat_id: String(chat), text, n: b2.length, b: b2 } }];"
      }
    },
